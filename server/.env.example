# Copy this file to .env and fill in your values

# MongoDB connection string (local or MongoDB Atlas cloud)
MONGODB_URI=mongodb://127.0.0.1:27017/safegati-packers

# Port the backend server runs on
PORT=5000

# Frontend URL (for CORS - allows React app to talk to this server)
CLIENT_URL=http://localhost:5173

# Optional: Email settings for enquiry notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL=sales@safegatipackers.org
